# Frigate internal API base URL. Optional from v0.9.0 — leave unset to enter
# the first-run setup wizard at http://<docker-host>:3200, which writes the
# URL to /data/config.yaml. Set here when env-based deployment is preferred;
# env always wins over the on-disk overlay.
# Use port 5000 (internal, no auth) — NOT :8971 which is the authed UI port.
# Frigate 0.17 serves both; :5000 skips auth even when auth.enabled=true.
# Use whatever hostname resolves to your Frigate container — `frigate` works
# if both run on the same Docker network.
FRIGATE_URL=http://frigate:5000

# Public URL of the Frigate UI, used for "Open in Frigate" deep-links from
# the events list. Must be reachable from the user's device. Defaults to
# FRIGATE_URL. Optional from v0.9.0 — also configurable from the wizard.
FRIGATE_UI_URL=http://frigate:5000

# go2rtc REST API for WHEP signaling (E2+). Optional; BFF starts without it.
# Also configurable from the first-run wizard.
GO2RTC_URL=http://frigate:1984

# Optional — defaults shown
PORT=3200
LOG_LEVEL=info
LOG_FORMAT=json
SNAPSHOT_CACHE_TTL=15s
HTTP_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# WHEP / MSE upstream timeouts
WHEP_TIMEOUT=10s
STREAM_PROXY_TIMEOUT=0          # 0 = no timeout, allows indefinite streaming
PREFS_PATH=/data/prefs.json

# Camera-group definitions (E3.3). YAML; auto-created on first POST /api/groups.
# Defaults to /data/groups.yaml (alongside prefs.json under the /data volume).
GROUPS_CONFIG_PATH=/data/groups.yaml

# Per-camera display name overrides. YAML map[cam_id]name; auto-created on
# first PUT /api/camera-names/{cam_id}. Cameras without an entry fall back
# to the Frigate-sourced name from cameras.yaml.
CAMERA_NAMES_CONFIG_PATH=/data/camera_names.yaml

# Camera registry persisted from Frigate config (E5). YAML; auto-created at
# first startup when Frigate is reachable. On subsequent starts the BFF falls
# back to this snapshot if Frigate is unreachable.
CAMERAS_CONFIG_PATH=/data/cameras.yaml

# Per-camera capability overrides (talk_back, ptz) — not exposed by Frigate
# /api/config, hand-edited on the host until a future editor lands. YAML
# map[cam_id]{talk_back,ptz}; missing file → all cameras get the zero value.
# Orphan cleanup on POST /api/cameras/refresh removes entries for cams that
# disappear from Frigate.
CAPABILITIES_CONFIG_PATH=/data/capabilities.yaml

# Per-camera go2rtc stream-name overrides (E6 sprint A). YAML map of cam_id
# to {main, sub}; applied only inside the WHEP handler. GET /api/cameras
# still surfaces Frigate-truth stream names.
STREAM_OVERRIDES_CONFIG_PATH=/data/stream_overrides.yaml

# Runtime config overlay written by the first-run setup wizard (E7). Stores
# the URLs entered in the browser as YAML (frigate_url, frigate_ui_url,
# go2rtc_url). Env vars above always win over this file. Auto-created on
# the first wizard save; missing file is the normal state for env-driven
# deployments.
RUNTIME_CONFIG_PATH=/data/config.yaml
